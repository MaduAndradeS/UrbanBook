generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ADM {
  ID_ADM     Int          @id @default(autoincrement())
  EMPRESARIO EMPRESARIO[]
}

model AGENDAMENTO {
  CONFIRMACAO    Boolean?
  DATA_HORA      DateTime    @db.DateTime(0)
  CANCELAMENTO   Boolean?
  ID_CLIENTE     Int?
  ID_EMPRESARIO  Int?
  ID_AGENDAMENTO Int         @id @default(autoincrement())
  EMPRESARIO     EMPRESARIO? @relation(fields: [ID_EMPRESARIO], references: [ID_EMPRESARIO], onDelete: NoAction, onUpdate: NoAction, map: "AGENDAMENTO_ibfk_1")
  CLIENTE        CLIENTE?    @relation(fields: [ID_CLIENTE], references: [ID_CLIENTE], onDelete: NoAction, onUpdate: NoAction, map: "AGENDAMENTO_ibfk_2")

  @@index([ID_CLIENTE], map: "ID_CLIENTE")
  @@index([ID_EMPRESARIO], map: "ID_EMPRESARIO")
}

model CLIENTE {
  ID_CLIENTE    Int           @id @default(autoincrement())
  NOME          String        @db.VarChar(100)
  CPF           String        @unique(map: "CPF") @db.Char(11)
  DATA_NASC     DateTime      @db.Date
  EMAIL         String        @unique(map: "EMAIL") @db.VarChar(100)
  SENHA_HASH    String        @db.VarChar(255)
  ID_EMPRESARIO Int?
  AGENDAMENTO   AGENDAMENTO[]
  EMPRESARIO    EMPRESARIO?   @relation(fields: [ID_EMPRESARIO], references: [ID_EMPRESARIO], onDelete: NoAction, onUpdate: NoAction, map: "CLIENTE_ibfk_1")
  ENDERECO      ENDERECO[]
  TELEFONE      TELEFONE[]

  @@index([ID_EMPRESARIO], map: "ID_EMPRESARIO")
}

model EMPRESARIO {
  ID_EMPRESARIO Int           @id @default(autoincrement())
  NOME          String        @db.VarChar(100)
  CNPJ          String        @unique(map: "CNPJ") @db.Char(14)
  BIO           String?       @db.VarChar(200)
  EMAIL         String        @unique(map: "EMAIL") @db.VarChar(100)
  SENHA_HASH    String        @db.VarChar(255)
  ID_ADM        Int?
  AGENDAMENTO   AGENDAMENTO[]
  CLIENTE       CLIENTE[]
  ADM           ADM?          @relation(fields: [ID_ADM], references: [ID_ADM], onDelete: NoAction, onUpdate: NoAction, map: "EMPRESARIO_ibfk_1")
  ENDERECO      ENDERECO[]
  SERVICOS      SERVICOS[]
  TELEFONE      TELEFONE[]

  @@index([ID_ADM], map: "ID_ADM")
}

model ENDERECO {
  ID_CLIENTE    Int?
  ID_EMPRESARIO Int?
  RUA           String      @db.VarChar(100)
  NUM           Int?
  BAIRRO        String      @db.VarChar(100)
  CIDADE        String      @db.VarChar(100)
  ESTADO        String      @db.VarChar(2)
  CEP           String      @db.Char(8)
  COMP          String?     @db.VarChar(20)
  ID_ENDERECO   Int         @id @default(autoincrement())
  EMPRESARIO    EMPRESARIO? @relation(fields: [ID_EMPRESARIO], references: [ID_EMPRESARIO], onDelete: NoAction, onUpdate: NoAction, map: "ENDERECO_ibfk_1")
  CLIENTE       CLIENTE?    @relation(fields: [ID_CLIENTE], references: [ID_CLIENTE], onDelete: NoAction, onUpdate: NoAction, map: "ENDERECO_ibfk_2")

  @@index([ID_CLIENTE], map: "ID_CLIENTE")
  @@index([ID_EMPRESARIO], map: "ID_EMPRESARIO")
}

model SERVICOS {
  NOME          String      @db.VarChar(100)
  ID_EMPRESARIO Int?
  ID_SERVICO    Int         @id @default(autoincrement())
  EMPRESARIO    EMPRESARIO? @relation(fields: [ID_EMPRESARIO], references: [ID_EMPRESARIO], onDelete: NoAction, onUpdate: NoAction, map: "SERVICOS_ibfk_1")

  @@index([ID_EMPRESARIO], map: "ID_EMPRESARIO")
}

model TELEFONE {
  ID_CLIENTE    Int?
  ID_EMPRESARIO Int?
  TELEFONE      String      @db.Char(14)
  ID_TELEFONE   Int         @id @default(autoincrement())
  EMPRESARIO    EMPRESARIO? @relation(fields: [ID_EMPRESARIO], references: [ID_EMPRESARIO], onDelete: NoAction, onUpdate: NoAction, map: "TELEFONE_ibfk_1")
  CLIENTE       CLIENTE?    @relation(fields: [ID_CLIENTE], references: [ID_CLIENTE], onDelete: NoAction, onUpdate: NoAction, map: "TELEFONE_ibfk_2")

  @@index([ID_CLIENTE], map: "ID_CLIENTE")
  @@index([ID_EMPRESARIO], map: "ID_EMPRESARIO")
}
